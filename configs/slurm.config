params {
  container_idr = "/ictstr01/groups/idc/projects/uhlenhaut/jiang/singularity_image/idr-2.0.3macs2.sif"
  queue         = 'cpu_p'
  extra_mounts  = ''
}

process {
  executor = 'slurm'
  queue          = params.queue
  clusterOptions = "--qos=cpu_normal --nice=10000 --mail-type=END,FAIL --mail-user=${params.mail_user}"

  cpus   = params.cpus
  memory = params.memory
  time   = params.time

  container        = params.container_idr
  containerOptions = params.extra_mounts


  withName: pseudo_idr {
    cpus   = 4
    memory = '16 GB'
    time   = '8h'
  }

}

singularity {
  enabled    = true
  autoMounts = true
}
